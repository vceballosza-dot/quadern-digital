    <!-- 5. HISTORIAL DE CANVIS -->
    <div id="tab-historial" class="tab-content">
      <div class="card">
        <h2>Historial de Canvis (Audit Log)</h2>
        <table>
          <thead>
            <tr>
              <th>Data i Hora</th>
              <th>Usuari / Executor</th>
              <th>Acció Realitzada</th>
            </tr>
          </thead>
          <tbody id="taula-historial">
            <!-- Es carrega dinàmicament -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- 6. GESTIÓ DE DADES -->
    <div id="tab-dades" class="tab-content">
      <div class="card">
        <h2>Exportació i Importació de Dades (JSON)</h2>
        <p style="margin-bottom: 15px;">
          Com que l'aplicació no utilitza un servidor centralitzat, cada membre té les dades al seu ordinador. Feu servir aquestes eines per compartir l'estat del projecte.
        </p>

        <div class="grid-2">
          <div style="border: 1px dashed var(--border); padding: 20px; border-radius: 8px; text-align: center;">
            <h3>Exportar Estat Actual</h3>
            <p style="font-size: 0.85rem; color: #718096; margin: 10px 0;">Descarrega un fitxer JSON amb tot el contingut actual del quadern.</p>
            <button class="btn btn-primary" onclick="exportarJSON()">📥 Descarregar JSON</button>
          </div>

          <div style="border: 1px dashed var(--border); padding: 20px; border-radius: 8px; text-align: center;">
            <h3>Importar i Fusionar JSON</h3>
            <p style="font-size: 0.85rem; color: #718096; margin: 10px 0;">Carrega el JSON d'un altre company. Les dades es fusionaran de manera intel·ligent sense esborrar la teva feina.</p>
            <input type="file" id="import-file" accept=".json" style="display: none;" onchange="importarJSON(event)">
            <button class="btn btn-secondary" onclick="document.getElementById('import-file').click()">📤 Carregar i Fusionar Fitxer</button>
          </div>
        </div>
      </div>

      <div class="card" style="border-color: var(--danger);">
        <h2 style="color: var(--danger);">Zona de Perill</h2>
        <p style="font-size: 0.9rem; margin-bottom: 15px;">Aquesta acció esborrarà totes les dades emmagatzemades localment en aquest navegador.</p>
        <button class="btn btn-danger" onclick="reiniciarDades()">⚠️ Restablir totes les dades</button>
      </div>
    </div>
  </div>

  <!-- Contenidor de Notificacions Flotants (Toasts) -->
  <div id="toast-container"></div>

  <script>
    // Membres de l'equip predeterminats per defecte
    const MEMBRES_DEFECTE = [
      { id: "m1", nom: "Jana Oltra Arrieta", rol: "", email: "" },
      { id: "m2", nom: "Judit Coll Portet", rol: "", email: "" },
      { id: "m3", nom: "Paola Fernández Franco", rol: "", email: "" },
      { id: "m4", nom: "Victor Ceballos Zarzoso", rol: "", email: "" },
      { id: "m5", nom: "Paula Gómez Manyes", rol: "", email: "" }
    ];

    // Estat Global de l'Aplicació
    let appState = {
      meta: {
        versio: "1.0",
        darreraModificacio: new Date().toISOString()
      },
      projecte: {
        nom: "",
        assignatura: "",
        professora: ""
      },
      equip: JSON.parse(JSON.stringify(MEMBRES_DEFECTE)),
      diari: [],
      tasques: [],
      historial: []
    };

    // Estat temporal per les subtasques del formulari
    let subtasksFormTemp = [];

    // SISTEMA DE NOTIFICACIONS TEMPORALS FLOTANTS (TOASTS)
    function mostrarToast(missatge, tipus = 'info', durada = 3500) {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `toast toast-${tipus}`;
      toast.innerHTML = `
        <span>${escapeHtml(missatge)}</span>
        <button class="toast-close" onclick="tancarToast(this.parentElement)">&times;</button>
      `;

      container.appendChild(toast);

      const timer = setTimeout(() => {
        tancarToast(toast);
      }, durada);

      toast.dataset.timer = timer;
    }

    function tancarToast(toast) {
      if (!toast) return;
      if (toast.dataset.timer) clearTimeout(toast.dataset.timer);
      toast.style.animation = 'toastFadeOut 0.3s ease-in forwards';
      setTimeout(() => {
        if (toast.parentElement) toast.parentElement.removeChild(toast);
      }, 300);
    }

    // Inicialització
    document.addEventListener("DOMContentLoaded", () => {
      carregarLocalStorage();
      establirDataHoraActual();
      renderitzarTot();
    });

    function establirDataHoraActual() {
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      document.getElementById('diari-data').value = now.toISOString().slice(0, 16);
    }

    function registrarAccio(accio, usuari = "Sistema") {
      appState.historial.unshift({
        id: "hist-" + Date.now() + "-" + Math.random().toString(36).substr(2, 4),
        timestamp: new Date().toISOString(),
        usuari: usuari,
        accio: accio
      });
    }

    function desarEstat(accioRealitzada, usuariAccio) {
      appState.meta.darreraModificacio = new Date().toISOString();
      if (accioRealitzada) {
        registrarAccio(accioRealitzada, usuariAccio || "Usuari");
      }
      localStorage.setItem("quadern_uoc_state", JSON.stringify(appState));
      renderitzarTot();
    }

    function carregarLocalStorage() {
      const saved = localStorage.getItem("quadern_uoc_state");
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          appState = parsed;

          if (!appState.equip || appState.equip.length === 0) {
            appState.equip = JSON.parse(JSON.stringify(MEMBRES_DEFECTE));
          }
        } catch (e) {
          console.error("Error carregant localStorage", e);
        }
      } else {
        registrarAccio("Inicialització de l'aplicació", "Sistema");
        localStorage.setItem("quadern_uoc_state", JSON.stringify(appState));
      }
    }

    // NAVEGACIÓ
    function showTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById('tab-' + tabId).classList.add('active');
      event.target.classList.add('active');
    }

    // RENDERITZACIÓ GENERAL
    function renderitzarTot() {
      renderitzarInfoGeneral();
      actualitzarDesplegablesEquip();
      renderitzarDiari();
      renderitzarTasques();
      renderitzarDashboard();
      renderitzarHistorial();
    }

    // 1. INFORMACIÓ GENERAL
    function renderitzarInfoGeneral() {
      document.getElementById('proj-nom').value = appState.projecte.nom || "";
      document.getElementById('proj-assignatura').value = appState.projecte.assignatura || "";
      document.getElementById('proj-professora').value = appState.projecte.professora || "";

      const tbody = document.getElementById('taula-equip');
      tbody.innerHTML = "";
      appState.equip.forEach((m, index) => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${escapeHtml(m.nom)}</strong></td>
            <td><input type="text" value="${escapeHtml(m.rol || '')}" onchange="actualitzarMembre(${index}, 'rol', this.value)" placeholder="Afegir rol..."></td>
            <td><input type="email" value="${escapeHtml(m.email || '')}" onchange="actualitzarMembre(${index}, 'email', this.value)" placeholder="correu@uoc.edu"></td>
            <td>
              <button class="btn btn-danger btn-sm" onclick="eliminarMembre(${index})">Esborrar</button>
            </td>
          </tr>
        `;
      });
    }

    function guardarInfoGeneral() {
      appState.projecte.nom = document.getElementById('proj-nom').value;
      appState.projecte.assignatura = document.getElementById('proj-assignatura').value;
      appState.projecte.professora = document.getElementById('proj-professora').value;
      desarEstat("Actualització de la informació general del projecte");
      mostrarToast("Dades generals desades correctament.", "success");
    }

    function actualitzarMembre(index, camp, valor) {
      appState.equip[index][camp] = valor;
      desarEstat(`Actualització del ${camp} de ${appState.equip[index].nom}`);
    }

    function obrirModalMembre() {
      const nom = prompt("Nom i cognoms del nou membre:");
      if (nom && nom.trim() !== "") {
        const nouId = "m-" + Date.now();
        appState.equip.push({ id: nouId, nom: nom.trim(), rol: "", email: "" });
        desarEstat(`Afegit nou membre de l'equip: ${nom.trim()}`);
      }
    }

    function eliminarMembre(index) {
      if (confirm(`Segur que vols eliminar ${appState.equip[index].nom} de l'equip?`)) {
        const nom = appState.equip[index].nom;
        appState.equip.splice(index, 1);
        desarEstat(`Eliminat membre de l'equip: ${nom}`);
      }
    }

    // ACTUALITZACIÓ DE DESPLEGABLES I OPCIONS EN TOTA LA UI
    function actualitzarDesplegablesEquip() {
      const selectAutor = document.getElementById('diari-autor');
      const valAutor = selectAutor.value;
      selectAutor.innerHTML = '<option value="">Selecciona un autor/a...</option>';
      appState.equip.forEach(m => {
        selectAutor.innerHTML += `<option value="${m.id}">${escapeHtml(m.nom)}</option>`;
      });
      selectAutor.value = valAutor;

      const selectFiltreAutor = document.getElementById('filtre-autor');
      const valFiltre = selectFiltreAutor.value;
      selectFiltreAutor.innerHTML = '<option value="">Tots els autors</option>';
      appState.equip.forEach(m => {
        selectFiltreAutor.innerHTML += `<option value="${m.id}">${escapeHtml(m.nom)}</option>`;
      });
      selectFiltreAutor.value = valFiltre;

      const containerPart = document.getElementById('container-participants');
      containerPart.innerHTML = "";
      appState.equip.forEach(m => {
        containerPart.innerHTML += `
          <div class="sub-item">
            <input type="checkbox" id="part-check-${m.id}" value="${m.id}" onchange="toggleAportacioInput('${m.id}')">
            <label for="part-check-${m.id}" style="width: 200px;">${escapeHtml(m.nom)}</label>
            <input type="text" id="part-text-${m.id}" placeholder="Aportació específica..." disabled style="flex: 1;">
          </div>
        `;
      });

      const containerResp = document.getElementById('container-tasca-responsables');
      containerResp.innerHTML = "";
      appState.equip.forEach(m => {
        containerResp.innerHTML += `
          <label style="font-weight: normal; cursor: pointer;">
            <input type="checkbox" name="tasca-resp" value="${m.id}"> ${escapeHtml(m.nom)}
          </label>
        `;
      });
    }

    function toggleAportacioInput(membreId) {
      const chk = document.getElementById(`part-check-${membreId}`);
      const txt = document.getElementById(`part-text-${membreId}`);
      txt.disabled = !chk.checked;
      if (!chk.checked) txt.value = "";
    }

    function afegirCampEnllac(text = "", url = "") {
      const container = document.getElementById('container-enllacos');
      const div = document.createElement('div');
      div.className = 'sub-item';
      div.innerHTML = `
        <input type="text" placeholder="Títol o descripció del document" class="enllac-text" value="${escapeHtml(text)}" style="flex:1;">
        <input type="text" placeholder="URL (https://...)" class="enllac-url" value="${escapeHtml(url)}" style="flex:1;">
        <button type="button" class="btn btn-danger btn-sm" onclick="this.parentElement.remove()">X</button>
      `;
      container.appendChild(div);
    }

    // 2. DIARI DEL PROJECTE
    function guardarEntradaDiari(e) {
      e.preventDefault();
      
      const idExistet = document.getElementById('diari-id').value;
      const autorId = document.getElementById('diari-autor').value;
      const autorObj = appState.equip.find(m => m.id === autorId);
      const nomAutor = autorObj ? autorObj.nom : "Desconegut";

      const participants = [];
      appState.equip.forEach(m => {
        const chk = document.getElementById(`part-check-${m.id}`);
        if (chk && chk.checked) {
          const txt = document.getElementById(`part-text-${m.id}`).value;
          participants.push({ membreId: m.id, aportacio: txt });
        }
      });

      const enllacos = [];
      document.querySelectorAll('#container-enllacos .sub-item').forEach(el => {
        const text = el.querySelector('.enllac-text').value;
        const url = el.querySelector('.enllac-url').value;
        if (url.trim() !== "") {
          enllacos.push({ text: text || url, url: url });
        }
      });

      const entradaData = {
        id: idExistet || "entry-" + Date.now() + "-" + Math.random().toString(36).substr(2, 4),
        dataHora: new Date(document.getElementById('diari-data').value).toISOString(),
        autorId: autorId,
        tipusActivitat: document.getElementById('diari-tipus').value,
        titol: document.getElementById('diari-titol').value,
        descripcio: document.getElementById('diari-descripcio').value,
        decisions: document.getElementById('diari-decisions').value,
        resultats: document.getElementById('diari-resultats').value,
        participants: participants,
        enllacos: enllacos
      };

      if (idExistet) {
        const idx = appState.diari.findIndex(x => x.id === idExistet);
        if (idx !== -1) appState.diari[idx] = entradaData;
        desarEstat(`Modificada entrada del diari: "${entradaData.titol}"`, nomAutor);
        mostrarToast("Entrada modificada correctament.", "success");
      } else {
        appState.diari.unshift(entradaData);
        desarEstat(`Nova entrada al diari: "${entradaData.titol}"`, nomAutor);
        mostrarToast("Nova entrada afegida al diari.", "success");
      }

      netejarFormDiari();
    }

    function netejarFormDiari() {
      document.getElementById('form-diari').reset();
      document.getElementById('diari-id').value = "";
      document.getElementById('container-enllacos').innerHTML = "";
      establirDataHoraActual();
      actualitzarDesplegablesEquip();
    }

    function renderitzarDiari() {
      filtrarDiari();
    }

    function filtrarDiari() {
      const query = document.getElementById('filtre-text').value.toLowerCase();
      const autorFiltre = document.getElementById('filtre-autor').value;
      const tipusFiltre = document.getElementById('filtre-tipus').value;
      const dataDesde = document.getElementById('filtre-data-desde').value;
      const dataFinsa = document.getElementById('filtre-data-finsa').value;

      const filtrats = appState.diari.filter(e => {
        const matchText = e.titol.toLowerCase().includes(query) || 
                          e.descripcio.toLowerCase().includes(query) || 
                          (e.decisions && e.decisions.toLowerCase().includes(query));
        const matchAutor = !autorFiltre || e.autorId === autorFiltre;
        const matchTipus = !tipusFiltre || e.tipusActivitat === tipusFiltre;
        
        let matchData = true;
        const entryDate = e.dataHora.slice(0, 10);
        if (dataDesde && entryDate < dataDesde) matchData = false;
        if (dataFinsa && entryDate > dataFinsa) matchData = false;

        return matchText && matchAutor && matchTipus && matchData;
      });

      const container = document.getElementById('llista-diari');
      container.innerHTML = "";

      if (filtrats.length === 0) {
        container.innerHTML = "<p style='color: #718096;'>No s'han trobat entrades amb els filtres seleccionats.</p>";
        return;
      }

      filtrats.forEach(e => {
        const autorObj = appState.equip.find(m => m.id === e.autorId);
        const nomAutor = autorObj ? autorObj.nom : "Autor desconegut";
        const dataFormatted = new Date(e.dataHora).toLocaleString('ca-ES');

        let participantsHTML = "";
        if (e.participants && e.participants.length > 0) {
          participantsHTML = "<div class='entry-section'><div class='entry-section-title'>Participants:</div><ul style='padding-left:20px; font-size:0.9rem;'>";
          e.participants.forEach(p => {
            const mObj = appState.equip.find(m => m.id === p.membreId);
            const mNom = mObj ? mObj.nom : "Membre";
            participantsHTML += `<li><strong>${escapeHtml(mNom)}</strong>: ${escapeHtml(p.aportacio || 'Sense detall específic')}</li>`;
          });
          participantsHTML += "</ul></div>";
        }

        let enllacosHTML = "";
        if (e.enllacos && e.enllacos.length > 0) {
          enllacosHTML = "<div class='entry-section'><div class='entry-section-title'>Evidències / Enllaços:</div><ul style='padding-left:20px; font-size:0.9rem;'>";
          e.enllacos.forEach(l => {
            enllacosHTML += `<li><a href="${escapeHtml(l.url)}" target="_blank" rel="noopener">${escapeHtml(l.text)}</a></li>`;
          });
          enllacosHTML += "</ul></div>";
        }

        container.innerHTML += `
          <div class="entry-card">
            <div class="entry-header">
              <span class="entry-title">${escapeHtml(e.titol)}</span>
              <div>
                <button class="btn btn-secondary btn-sm" onclick="editarEntradaDiari('${e.id}')">Editar</button>
                <button class="btn btn-danger btn-sm" onclick="eliminarEntradaDiari('${e.id}')">Esborrar</button>
              </div>
            </div>
            <div class="entry-meta">
              <span>📅 ${dataFormatted}</span>
              <span>👤 <strong>${escapeHtml(nomAutor)}</strong></span>
              <span class="badge badge-activity">${escapeHtml(e.tipusActivitat)}</span>
            </div>
            <div style="font-size: 0.95rem; margin-bottom: 8px;">${escapeHtml(e.descripcio)}</div>
            ${e.decisions ? `<div class="entry-section"><div class="entry-section-title">Decisions & Justificació:</div><div style="font-size:0.9rem;">${escapeHtml(e.decisions)}</div></div>` : ''}
            ${e.resultats ? `<div class="entry-section"><div class="entry-section-title">Resultats:</div><div style="font-size:0.9rem;">${escapeHtml(e.resultats)}</div></div>` : ''}
            ${participantsHTML}
            ${enllacosHTML}
          </div>
        `;
      });
    }

    function editarEntradaDiari(id) {
      const e = appState.diari.find(x => x.id === id);
      if (!e) return;

      document.getElementById('diari-id').value = e.id;
      const d = new Date(e.dataHora);
      d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
      document.getElementById('diari-data').value = d.toISOString().slice(0, 16);
      document.getElementById('diari-autor').value = e.autorId;
      document.getElementById('diari-tipus').value = e.tipusActivitat;
      document.getElementById('diari-titol').value = e.titol;
      document.getElementById('diari-descripcio').value = e.descripcio;
      document.getElementById('diari-decisions').value = e.decisions || "";
      document.getElementById('diari-resultats').value = e.resultats || "";

      actualitzarDesplegablesEquip();

      if (e.participants) {
        e.participants.forEach(p => {
          const chk = document.getElementById(`part-check-${p.membreId}`);
          const txt = document.getElementById(`part-text-${p.membreId}`);
          if (chk) {
            chk.checked = true;
            txt.disabled = false;
            txt.value = p.aportacio || "";
          }
        });
      }

      document.getElementById('container-enllacos').innerHTML = "";
      if (e.enllacos) {
        e.enllacos.forEach(l => afegirCampEnllac(l.text, l.url));
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function eliminarEntradaDiari(id) {
      if (confirm("Segur que vols eliminar aquesta entrada del diari?")) {
        const idx = appState.diari.findIndex(x => x.id === id);
        if (idx !== -1) {
          const titol = appState.diari[idx].titol;
          appState.diari.splice(idx, 1);
          desarEstat(`Eliminada entrada del diari: "${titol}"`);
          mostrarToast("Entrada eliminada correctament.", "info");
        }
      }
    }

    // 3. GESTIÓ DE TASQUES I SUBTASQUES
    function afegirSubtascaForm() {
      const input = document.getElementById('tasca-nova-subtasca');
      const text = input.value.trim();
      if (!text) return;

      subtasksFormTemp.push({
        id: "sub-" + Date.now() + "-" + Math.random().toString(36).substr(2, 3),
        text: text,
        completada: false
      });

      input.value = "";
      renderitzarSubtasquesForm();
    }

    function eliminarSubtascaForm(index) {
      subtasksFormTemp.splice(index, 1);
      renderitzarSubtasquesForm();
    }

    function renderitzarSubtasquesForm() {
      const container = document.getElementById('container-subtasques-form');
      container.innerHTML = "";
      subtasksFormTemp.forEach((st, idx) => {
        const div = document.createElement('div');
        div.className = 'sub-item';
        div.innerHTML = `
          <span style="flex:1; font-size:0.9rem;">- ${escapeHtml(st.text)}</span>
          <button type="button" class="btn btn-danger btn-sm" style="padding: 2px 6px;" onclick="eliminarSubtascaForm(${idx})">🗑️</button>
        `;
        container.appendChild(div);
      });
    }

    function guardarTasca(e) {
      e.preventDefault();

      const idExistent = document.getElementById('tasca-id').value;
      const respIds = [];
      document.querySelectorAll('input[name="tasca-resp"]:checked').forEach(chk => {
        respIds.push(chk.value);
      });

      if (respIds.length === 0) {
        mostrarToast("Selecciona almenys un responsable per a la tasca.", "warning");
        return;
      }

      const tascaData = {
        id: idExistent || "task-" + Date.now() + "-" + Math.random().toString(36).substr(2, 4),
        descripcio: document.getElementById('tasca-descripcio').value,
        responsablesIds: respIds,
        dataLimit: document.getElementById('tasca-limit').value,
        estat: document.getElementById('tasca-estat').value,
        subtasques: [...subtasksFormTemp]
      };

      if (idExistent) {
        const idx = appState.tasques.findIndex(x => x.id === idExistent);
        if (idx !== -1) appState.tasques[idx] = tascaData;
        desarEstat(`Modificada tasca: "${tascaData.descripcio}"`);
        mostrarToast("Tasca actualitzada correctament.", "success");
      } else {
        appState.tasques.push(tascaData);
        desarEstat(`Nova tasca creada: "${tascaData.descripcio}"`);
        mostrarToast("Nova tasca desada al tauler.", "success");
      }

      netejarFormTasca();
    }

    function netejarFormTasca() {
      document.getElementById('form-tasca').reset();
      document.getElementById('tasca-id').value = "";
      subtasksFormTemp = [];
      renderitzarSubtasquesForm();
    }

    // INDICADORS VISUALS DE TERMINI (DEADLINES)
    function obtenirEstatTermini(dataLimitStr, estatTasca) {
      if (estatTasca === 'Completada') {
        return { classe: 'badge-done', text: '✅ Finalitzada', esVencuda: false };
      }
      if (!dataLimitStr) return { classe: '', text: '', esVencuda: false };

      const avui = new Date();
      avui.setHours(0, 0, 0, 0);

      const limit = new Date(dataLimitStr);
      limit.setHours(0, 0, 0, 0);

      const diffMs = limit.getTime() - avui.getTime();
      const diffDies = Math.round(diffMs / (1000 * 60 * 60 * 24));

      if (diffDies < 0) {
        const diesAbs = Math.abs(diffDies);
        return {
          classe: 'badge-vencuda',
          text: `⚠️ Vençuda fa ${diesAbs} dia${diesAbs > 1 ? 's' : ''}`,
          esVencuda: true
        };
      } else if (diffDies === 0) {
        return { classe: 'badge-urgent', text: '⏳ Venç avui', esVencuda: false };
      } else if (diffDies === 1) {
        return { classe: 'badge-urgent', text: '⏳ Venç demà', esVencuda: false };
      } else if (diffDies <= 3) {
        return { classe: 'badge-urgent', text: `⏳ Queden ${diffDies} dies`, esVencuda: false };
      } else {
        return { classe: 'badge-ok', text: `📅 Queden ${diffDies} dies`, esVencuda: false };
      }
    }

    function toggleSubtascaKanban(taskId, subId) {
      const task = appState.tasques.find(t => t.id === taskId);
      if (!task || !task.subtasques) return;

      const sub = task.subtasques.find(s => s.id === subId);
      if (sub) {
        sub.completada = !sub.completada;
        desarEstat(`Actualitzat estat subtasca "${sub.text}" a tasca: ${task.descripcio}`);
      }
    }

    function renderitzarTasques() {
      const cols = {
        'Pendent': document.getElementById('tasks-pendent'),
        'En procés': document.getElementById('tasks-proces'),
        'Bloquejada': document.getElementById('tasks-bloquejada'),
        'Completada': document.getElementById('tasks-completada')
      };

      const counts = { 'Pendent': 0, 'En procés': 0, 'Bloquejada': 0, 'Completada': 0 };

      Object.keys(cols).forEach(k => cols[k].innerHTML = "");

      appState.tasques.forEach(t => {
        counts[t.estat] = (counts[t.estat] || 0) + 1;

        const respNoms = t.responsablesIds.map(id => {
          const m = appState.equip.find(x => x.id === id);
          return m ? m.nom : "Desconegut";
        }).join(", ");

        const statusTermini = obtenirEstatTermini(t.dataLimit, t.estat);

        const cssClass = t.estat === 'Pendent' ? 'task-pendent' :
                         t.estat === 'En procés' ? 'task-proces' :
                         t.estat === 'Bloquejada' ? 'task-bloquejada' : 'task-completada';

        // Generació HTML subtasques
        let subtasquesHTML = "";
        if (t.subtasques && t.subtasques.length > 0) {
          const totalSub = t.subtasques.length;
          const doneSub = t.subtasques.filter(s => s.completada).length;
          subtasquesHTML += `<div class="subtask-progress">Subtasques: ${doneSub}/${totalSub}</div>`;
          subtasquesHTML += `<div class="subtask-list">`;
          t.subtasques.forEach(st => {
            subtasquesHTML += `
              <div class="subtask-item ${st.completada ? 'completed' : ''}">
                <input type="checkbox" ${st.completada ? 'checked' : ''} onchange="toggleSubtascaKanban('${t.id}', '${st.id}')">
                <span>${escapeHtml(st.text)}</span>
              </div>
            `;
          });
          subtasquesHTML += `</div>`;
        }

        const card = document.createElement('div');
        card.className = `task-card ${cssClass} ${statusTermini.esVencuda ? 'task-vencuda' : ''}`;
        card.innerHTML = `
          <div class="task-title">${escapeHtml(t.descripcio)}</div>
          <div class="task-meta">
            👤 ${escapeHtml(respNoms)}<br>
            📅 Deadline: ${t.dataLimit}<br>
            <span class="badge-deadline ${statusTermini.classe}">${statusTermini.text}</span>
          </div>
          ${subtasquesHTML}
          <div style="display: flex; gap: 5px; flex-wrap: wrap; margin-top: 10px;">
            <select onchange="canviarEstatTasca('${t.id}', this.value)" style="padding: 2px 5px; font-size: 0.8rem;">
              <option value="Pendent" ${t.estat === 'Pendent' ? 'selected' : ''}>Pendent</option>
              <option value="En procés" ${t.estat === 'En procés' ? 'selected' : ''}>En procés</option>
              <option value="Bloquejada" ${t.estat === 'Bloquejada' ? 'selected' : ''}>Bloquejada</option>
              <option value="Completada" ${t.estat === 'Completada' ? 'selected' : ''}>Completada</option>
            </select>
            <button class="btn btn-danger btn-sm" style="padding: 2px 6px;" onclick="eliminarTasca('${t.id}')">🗑️</button>
          </div>
        `;
        if (cols[t.estat]) cols[t.estat].appendChild(card);
      });

      document.getElementById('count-pendent').innerText = counts['Pendent'];
      document.getElementById('count-proces').innerText = counts['En procés'];
      document.getElementById('count-bloquejada').innerText = counts['Bloquejada'];
      document.getElementById('count-completada').innerText = counts['Completada'];
    }

    function canviarEstatTasca(id, nouEstat) {
      const t = appState.tasques.find(x => x.id === id);
      if (t) {
        const vellEstat = t.estat;
        t.estat = nouEstat;
        desarEstat(`Canvi estat tasca "${t.descripcio}": ${vellEstat} ➔ ${nouEstat}`);
        mostrarToast(`Tasca moguda a: ${nouEstat}`, "info");
      }
    }

    function eliminarTasca(id) {
      if (confirm("Segur que vols eliminar aquesta tasca?")) {
        const idx = appState.tasques.findIndex(x => x.id === id);
        if (idx !== -1) {
          const desc = appState.tasques[idx].descripcio;
          appState.tasques.splice(idx, 1);
          desarEstat(`Eliminada tasca: "${desc}"`);
          mostrarToast("Tasca eliminada.", "info");
        }
      }
    }

    // 4. SEGUIMENT I INDICADORS
    function renderitzarDashboard() {
      const totalTasques = appState.tasques.length;
      const completades = appState.tasques.filter(t => t.estat === 'Completada').length;
      const pc = totalTasques > 0 ? Math.round((completades / totalTasques) * 100) : 0;

      document.getElementById('dash-progress-pc').innerText = `${pc}%`;
      document.getElementById('dash-total-tasks').innerText = totalTasques;
      document.getElementById('dash-total-entries').innerText = appState.diari.length;
      document.getElementById('dash-progress-bar').style.width = `${pc}%`;

      const tbody = document.getElementById('dash-taula-participacio');
      tbody.innerHTML = "";

      appState.equip.forEach(m => {
        const entradesCreades = appState.diari.filter(e => e.autorId === m.id).length;
        
        let participacions = 0;
        appState.diari.forEach(e => {
          if (e.participants && e.participants.some(p => p.membreId === m.id)) {
            participacions++;
          }
        });

        const tasquesAssignades = appState.tasques.filter(t => t.responsablesIds && t.responsablesIds.includes(m.id)).length;
        const tasquesCompletades = appState.tasques.filter(t => t.responsablesIds && t.responsablesIds.includes(m.id) && t.estat === 'Completada').length;

        tbody.innerHTML += `
          <tr>
            <td><strong>${escapeHtml(m.nom)}</strong></td>
            <td>${entradesCreades}</td>
            <td>${participacions}</td>
            <td>${tasquesAssignades}</td>
            <td>${tasquesCompletades}</td>
          </tr>
        `;
      });
    }

    // 5. HISTORIAL DE CANVIS
    function renderitzarHistorial() {
      const tbody = document.getElementById('taula-historial');
      tbody.innerHTML = "";

      appState.historial.slice(0, 50).forEach(h => {
        const dataFormatted = new Date(h.timestamp).toLocaleString('ca-ES');
        tbody.innerHTML += `
          <tr>
            <td style="font-size: 0.85rem; color: #718096;">${dataFormatted}</td>
            <td><strong>${escapeHtml(h.usuari)}</strong></td>
            <td>${escapeHtml(h.accio)}</td>
          </tr>
        `;
      });
    }

    // 6. GESTIÓ DE DADES (EXPORT/IMPORT JSON)
    function exportarJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `quadern_projecte_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      registrarAccio("Exportació de dades en fitxer JSON", "Usuari");
      mostrarToast("Fitxer JSON exportat correctament.", "success");
    }

    function importarJSON(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const importedData = JSON.parse(e.target.result);

          if (importedData.projecte) {
            if (!appState.projecte.nom) appState.projecte.nom = importedData.projecte.nom;
            if (!appState.projecte.assignatura) appState.projecte.assignatura = importedData.projecte.assignatura;
            if (!appState.projecte.professora) appState.projecte.professora = importedData.projecte.professora;
          }

          if (importedData.equip && Array.isArray(importedData.equip)) {
            importedData.equip.forEach(mImport => {
              const existeix = appState.equip.find(m => m.id === mImport.id || m.nom.toLowerCase() === mImport.nom.toLowerCase());
              if (!existeix) {
                appState.equip.push(mImport);
              }
            });
          }

          let entradesNoves = 0;
          if (importedData.diari && Array.isArray(importedData.diari)) {
            importedData.diari.forEach(eImport => {
              const idx = appState.diari.findIndex(e => e.id === eImport.id);
              if (idx === -1) {
                appState.diari.push(eImport);
                entradesNoves++;
              } else {
                if (new Date(eImport.dataHora) > new Date(appState.diari[idx].dataHora)) {
                  appState.diari[idx] = eImport;
                }
              }
            });
            appState.diari.sort((a, b) => new Date(b.dataHora) - new Date(a.dataHora));
          }

          let tasquesNoves = 0;
          if (importedData.tasques && Array.isArray(importedData.tasques)) {
            importedData.tasques.forEach(tImport => {
              const idx = appState.tasques.findIndex(t => t.id === tImport.id);
              if (idx === -1) {
                appState.tasques.push(tImport);
                tasquesNoves++;
              } else {
                appState.tasques[idx] = tImport;
              }
            });
          }

          desarEstat(`Importació de fitxer JSON: afegides ${entradesNoves} entrades noves i ${tasquesNoves} tasques.`);
          mostrarToast(`Importació completada! (+${entradesNoves} entrades, +${tasquesNoves} tasques)`, "success", 5000);

        } catch (err) {
          mostrarToast("Error en llegir el fitxer JSON. Revisa el format.", "danger");
          console.error(err);
        }
      };
      reader.readAsText(file);
    }

    function reiniciarDades() {
      if (confirm("ATENCIÓ: Això esborrarà totes les dades del quadern en aquest navegador. Vols continuar?")) {
        localStorage.removeItem("quadern_uoc_state");
        appState = {
          meta: { versio: "1.0", darreraModificacio: new Date().toISOString() },
          projecte: { nom: "", assignatura: "", professora: "" },
          equip: JSON.parse(JSON.stringify(MEMBRES_DEFECTE)),
          diari: [],
          tasques: [],
          historial: []
        };
        desarEstat("Restabliment complet de dades de l'aplicació", "Sistema");
        mostrarToast("Dades restablertes correctament.", "info");
      }
    }

    function escapeHtml(text) {
      if (!text) return "";
      return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
