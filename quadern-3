          </div>
          <div class="metric-box">
            <div>Total Tasques</div>
            <div class="metric-value" id="dash-total-tasks">0</div>
          </div>
          <div class="metric-box">
            <div>Entrades al Diari</div>
            <div class="metric-value" id="dash-total-entries">0</div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <label style="font-weight: 600;">Estat Global de les Tasques</label>
          <div class="progress-bar-container">
            <div id="dash-progress-bar" class="progress-bar"></div>
          </div>
        </div>
